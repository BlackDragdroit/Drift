# --- Required ---------------------------------------------------------------
# Password for the single-user login.
APP_PASSWORD=change-me
# Random secret (>= 32 chars). Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Anthropic (needed for PDF exercise import, flashcard generation, ...) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage ----------------------------------------------------------------
# Directory holding app.db and uploads/. Mount this as a persistent volume.
DATA_DIR=/data

# --- Optional ---------------------------------------------------------------
# Set to false when running locally over plain http (cookies would otherwise be rejected).
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=50
EXTRACT_CHUNK_PAGES=8
LOG_LEVEL=info
